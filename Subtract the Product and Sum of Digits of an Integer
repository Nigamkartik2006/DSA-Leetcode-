Given an integer number n, return the difference between the product of its digits and the sum of its digits.

Solution

class Solution {
    public int subtractProductAndSum(int n) {
        int prod=1;
        int sum=0;
        while(n>0){
          int digit=n%10;
          prod=digit*prod;
          sum+=digit; 
          n=n/10; 
        }
        return prod-sum;
    }
}
